# Copy to .env for local experiments — .env is git-ignored and must never be committed.
# The MCP server reads these from its process environment only.

# Required. Telnyx API key (Portal → Auth → API Keys).
TELNYX_API_KEY=

# Optional. Directory for generated MP3 files. Default: <os-temp>/telnyx-mcp
TELNYX_TTS_OUTPUT_DIR=

# Optional. HTTP timeout per attempt in milliseconds. Default: 120000
TELNYX_TTS_TIMEOUT_MS=

# Optional. Attempts per request before giving up. Default: 3
TELNYX_TTS_MAX_RETRIES=
